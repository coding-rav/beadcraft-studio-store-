# ---- Browser (Vite) variables: set in Vercel -> Settings -> Environment Variables ----
# Public by design. NEVER put a service-role key or any Razorpay secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase "anon" JWT key OR the newer "publishable" key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SITE_URL=http://localhost:5173

# ---- Server-side secrets are NOT Vite variables. Set them in Supabase (see README):
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxxx RAZORPAY_KEY_SECRET=xxxx RAZORPAY_WEBHOOK_SECRET=xxxx
#   supabase secrets set RESEND_API_KEY=re_xxxx EMAIL_FROM="Beadcraft Studio <orders@yourdomain.com>"   (optional: order emails)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically.
